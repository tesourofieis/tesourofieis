{
  "$schema": "https://unpkg.com/knip@6/schema.jsonc",
  // Vendored oxlint plugin: consumed by `.oxlintrc.json` (jsPlugins), not
  // imported by app code, so it does not participate in the import graph.
  "ignore": ["tools/oxlint/anti-slop/**"],
  "entry": [
    // Alchemy IaC: stack entry + the Workers asset fallback worker it wires up.
    "alchemy.run.ts",
    "infra/site-worker.ts",
    // Build tooling executed via `bunx tsx` / `node` from package scripts.
    "scripts/**/*.{ts,mjs}",
    // Manual perf harness (`bunx vitest bench` only picks up *.bench.ts).
    "lib/tests/bench/calendar.perf.ts",
  ],
  // eas-cli is invoked pinned via `bunx eas-cli@20.2.0` in the deploy/update
  // scripts (kept out of devDependencies: its vendored legacy @expo/* copies
  // shadow the SDK's own packages under bun's hoisted layout);
  // expo-atlas is activated by EXPO_UNSTABLE_ATLAS=1 in the start script.
  "ignoreDependencies": ["expo-atlas"],
}
