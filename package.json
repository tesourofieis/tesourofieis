{
  "name": "@tesourofieis/expo",
  "version": "1.2.0",
  "private": true,
  "main": "./index",
  "scripts": {
    "check": "tsc --noEmit",
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "start": "EXPO_UNSTABLE_ATLAS=1 expo start --dev-client",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "prebuild": "npx tsx ./scripts/build-search-index.ts && npx tsx ./scripts/generate-sitemap.ts",
    "dev": "npm run prebuild && expo start --clear",
    "deploy": "npx eas-cli build --platform all --auto-submit --profile production --non-interactive --no-wait",
    "update": "npx eas-cli update --auto",
    "test": "vitest .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@expo-google-fonts/cardo": "^0.4.1",
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo-google-fonts/dm-serif-text": "^0.4.1",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/drawer": "^7.5.0",
    "@tailwindcss/postcss": "^4.1.16",
    "date-fns": "^3.6.0",
    "expo": "^55.0.0",
    "expo-application": "~55.0.8",
    "expo-blur": "~55.0.8",
    "expo-clipboard": "~55.0.8",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.10",
    "expo-device": "~55.0.9",
    "expo-file-system": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.8",
    "expo-image": "~55.0.5",
    "expo-insights": "~55.0.10",
    "expo-intent-launcher": "~55.0.8",
    "expo-linking": "~55.0.7",
    "expo-localization": "~55.0.8",
    "expo-navigation-bar": "~55.0.8",
    "expo-notifications": "~55.0.10",
    "expo-router": "~55.0.3",
    "expo-secure-store": "~55.0.8",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "expo-updates": "~55.0.12",
    "expo-web-browser": "~55.0.9",
    "glob": "^11.0.3",
    "lucide-react-native": "^0.562.0",
    "minisearch": "^7.2.0",
    "nativewind": "5.0.0-preview.2",
    "postcss": "^8.5.6",
    "posthog-react-native": "^4.17.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-css": "^3.0.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@expo/metro-runtime": "~55.0.6",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.19.3",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "expo-atlas": "^0.4.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
