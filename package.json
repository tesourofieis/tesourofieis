{
  "name": "@tesourofieis/expo",
  "version": "1.1.0",
  "private": true,
  "main": "./index",
  "scripts": {
    "check": "tsc --noEmit",
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "start": "EXPO_UNSTABLE_ATLAS=1 expo start --dev-client",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "prebuild": "npx tsx ./scripts/build-search-index.ts",
    "dev": "npm run prebuild && expo start --clear --dev-client",
    "deploy": "npx eas-cli build --platform all --auto-submit --profile production --non-interactive --no-wait",
    "update": "npx eas-cli update --auto",
    "test": "vitest ."
  },
  "dependencies": {
    "@expo-google-fonts/cardo": "^0.4.1",
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo-google-fonts/dm-serif-text": "^0.4.1",
    "@expo-google-fonts/noto-sans": "^0.2.3",
    "@expo/html-elements": "^0.10.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-native/assets-registry": "^0.75.5",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "@tailwindcss/postcss": "^4.1.16",
    "date-fns": "^3.6.0",
    "expo": "~54.0.21",
    "expo-blur": "~15.0.7",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.16",
    "expo-device": "~8.0.9",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-insights": "~0.10.7",
    "expo-intent-launcher": "~13.0.7",
    "expo-linking": "~8.0.8",
    "expo-navigation-bar": "~5.0.9",
    "expo-notifications": "~0.32.12",
    "expo-router": "~6.0.14",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.8",
    "expo-updates": "~29.0.12",
    "expo-web-browser": "^15.0.8",
    "glob": "^11.0.3",
    "lucide-react": "^0.562.0",
    "lucide-react-native": "^0.562.0",
    "nativewind": "5.0.0-preview.2",
    "postcss": "^8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "~0.81.5",
    "react-native-css": "^3.0.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-picker-select": "^9.3.1",
    "react-native-reanimated": "~4.1.3",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
