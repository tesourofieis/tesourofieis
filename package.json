{
  "name": "@tesourofieis/expo",
  "version": "1.3.1",
  "private": true,
  "main": "./index",
  "scripts": {
    "check": "tsc --noEmit",
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "start": "EXPO_UNSTABLE_ATLAS=1 expo start --dev-client",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:web": "expo export --platform web --source-maps=false",
    "lint": "oxlint . && oxfmt --check . && expo lint",
    "lint:fix": "oxlint --fix . && oxfmt . && expo lint --fix",
    "format": "oxfmt --write .",
    "prebuild": "npx tsx ./scripts/build-search-index.ts && npx tsx ./scripts/generate-sitemap.ts",
    "dev": "npm run prebuild && expo start --clear",
    "deploy": "for i in 1 2 3; do NODE_OPTIONS=--dns-result-order=ipv4first npx eas-cli build --platform all --auto-submit --profile production --non-interactive --no-wait && exit 0; echo \"deploy attempt $i failed, retrying...\"; sleep 30; done; exit 1",
    "update": "for i in 1 2 3; do NODE_OPTIONS=--dns-result-order=ipv4first npx eas-cli update --auto --environment production && exit 0; echo \"update attempt $i failed, retrying...\"; sleep 30; done; exit 1",
    "test": "vitest .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "knip": "knip",
    "cf:dev": "alchemy dev",
    "cf:deploy": "alchemy deploy",
    "cf:deploy:prod": "alchemy deploy --stage prod",
    "cf:destroy": "alchemy destroy"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.8",
    "@marceloterreiro/flash-calendar": "^2.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tailwindcss/postcss": "^4.1.16",
    "date-fns": "^3.6.0",
    "expo": "^56.0.12",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.17",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.20",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-image": "~56.0.11",
    "expo-insights": "~56.0.18",
    "expo-intent-launcher": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-localization": "~56.0.6",
    "expo-navigation-bar": "~56.0.3",
    "expo-notifications": "~56.0.18",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.19",
    "expo-web-browser": "~56.0.5",
    "glob": "^11.0.3",
    "lucide-react-native": "^0.562.0",
    "minisearch": "^7.2.0",
    "nativewind": "5.0.0-preview.2",
    "postcss": "^8.5.6",
    "posthog-react-native": "^4.17.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css": "^3.0.1",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@effect/platform-node": "^4.0.0-rc.111",
    "@expo/metro-runtime": "~56.0.15",
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.19.3",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "alchemy": "2.0.0-beta.74",
    "eas-cli": "20.2.0",
    "effect": "^4.0.0-rc.111",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "expo-atlas": "^0.4.3",
    "knip": "6.32.2",
    "oxfmt": "^0.41.0",
    "oxlint": "1.79.0",
    "tailwindcss": "^4.1.16",
    "typescript": "~6.0.3",
    "vitest": "^1.6.1"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
