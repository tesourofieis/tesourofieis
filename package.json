    "@types/react-dom": "~19.1.7",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "expo-atlas": "^0.4.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
