{
  "name": "@tesourofieis/expo",
  "version": "0.5.9",
  "private": true,
  "main": "./index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "start": "EXPO_UNSTABLE_ATLAS=1 expo start --dev-client",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "pnpx biome check --write --unsafe --files-ignore-unknown=true",
    "prebuild": "pnpx tsx ./scripts/build-search-index.ts",
    "dev": "pnpm run prebuild --clean && expo start --clear --dev-client",
    "deploy": "pnpx eas-cli build --platform all --auto-submit --profile production --non-interactive --no-wait",
    "update": "pnpx eas-cli update --auto"
  },
  "dependencies": {
    "@expo-google-fonts/cardo": "^0.4.1",
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo-google-fonts/dm-serif-text": "^0.4.1",
    "@expo-google-fonts/noto-sans": "^0.2.3",
    "@expo/html-elements": "^0.10.1",
    "@expo/vector-icons": "^15.0.3",
    "@iconify/react": "^5.2.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/assets-registry": "^0.75.5",
    "@react-navigation/drawer": "^7.7.2",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "@tailwindcss/postcss": "^4.1.16",
    "@tesourofieis/cal": "workspace:*",
    "date-fns": "catalog:",
    "expo": "~54.0.21",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.16",
    "expo-device": "~8.0.9",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-insights": "~0.10.7",
    "expo-intent-launcher": "~13.0.7",
    "expo-linking": "~8.0.8",
    "expo-navigation-bar": "~5.0.9",
    "expo-notifications": "~0.32.12",
    "expo-router": "~6.0.14",
    "expo-secure-store": "^15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.8",
    "expo-updates": "~29.0.12",
    "expo-web-browser": "^15.0.8",
    "glob": "^11.0.3",
    "nativewind": "5.0.0-preview.2",
    "postcss": "^8.5.6",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "~0.81.5",
    "react-native-css": "^3.0.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.3",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@expo/metro-runtime": "6.1.2",
    "@tesourofieis/tsconfig": "workspace:*",
    "@types/node": "^22.18.10",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.11",
    "expo-atlas": "^0.4.3",
    "tailwindcss": "catalog:",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
