{
  "name": "@tesourofieis/expo",
  "version": "0.4.9",
  "private": true,
  "main": "./index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "start": "EXPO_UNSTABLE_ATLAS=1 expo start -d",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "android": "expo run:android",
    "submit": "eas build --platform all --auto-submit --profile production --non-interactive --no-wait",
    "ios": "expo run:ios",
    "lint": "pnpx biome check --write --unsafe --files-ignore-unknown=true",
    "prebuild": "pnpx tsx ./scripts/build-search-index.ts",
    "dev": "npm run prebuild && expo start --clear"
  },
  "dependencies": {
    "@expo-google-fonts/cardo": "^0.4.0",
    "@expo-google-fonts/dm-serif-display": "^0.4.1",
    "@expo-google-fonts/dm-serif-text": "^0.4.0",
    "@expo-google-fonts/noto-sans": "^0.2.3",
    "@expo/html-elements": "^0.10.1",
    "@expo/metro-config": "^0.19.4",
    "@expo/vector-icons": "^14.0.2",
    "@iconify/react": "^5.0.1",
    "@react-native/assets-registry": "^0.75.1",
    "@react-navigation/native": "^7.0.14",
    "@shopify/flash-list": "1.7.3",
    "@tesourofieis/cal": "workspace:*",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^12.2.0",
    "date-fns": "catalog:",
    "drizzle-orm": "^0.44.2",
    "expo": "~52.0.47",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-device": "~7.0.3",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.7",
    "expo-insights": "~0.8.2",
    "expo-intent-launcher": "~12.0.2",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.21",
    "expo-secure-store": "^14.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "expo-updates": "~0.27.4",
    "expo-web-browser": "^14.0.2",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "nativewind": "~4.0.36",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "~0.76.9",
    "react-native-css-interop": "~0.0.34",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.3",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@tesourofieis/tsconfig": "workspace:*",
    "@types/babel__core": "^7.20.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "^0.31.4",
    "expo-atlas": "^0.4.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "catalog:"
